{
  "name": "i18n-boost",
  "displayName": "I18n Boost",
  "publisher": "mrgwd",
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "src/images/icon.webp",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "description": "Supercharge your i18n workflow — works with your favorite library.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "json",
    "typescript",
    "javascript"
  ],
  "activationEvents": [
    "onCommand:i18nBoost.selectLocale",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "i18nBoost.copyFullKey",
        "title": "I18n Boost: Copy translation key"
      },
      {
        "command": "i18nBoost.createConfig",
        "title": "I18n Boost: Create config file"
      },
      {
        "command": "i18nBoost.showLocales",
        "title": "I18n Boost: Show available locales"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "i18nBoost.copyFullKey",
          "when": "editorTextFocus && editorLangId == 'json'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "I18n Boost Configuration",
      "properties": {
        "i18nBoost.localesPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": "src/i18n",
          "description": "Path to translation files folder (relative to workspace root). Can be a string or an array of strings (supports globs)."
        },
        "i18nBoost.defaultLocale": {
          "type": "string",
          "default": "en",
          "description": "Default locale to navigate to on Ctrl+Click."
        },
        "i18nBoost.functionNames": {
          "type": "array",
          "default": [
            "t",
            "translate",
            "$t",
            "i18n.t",
            "t.raw",
            "t.rich"
          ],
          "description": "Function names that indicate translation keys.",
          "items": {
            "type": "string"
          }
        },
        "i18nBoost.fileNamingPattern": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "locale.json",
            "locale/**/*.json"
          ],
          "description": "Pattern for locale file naming. 'locale/**/*.json' supports both flat and nested directory structures."
        },
        "i18nBoost.keyStrategy": {
          "type": "string",
          "default": "filename",
          "enum": [
            "filename",
            "flat"
          ],
          "description": "Strategy for generating translation keys. 'filename' uses file/folder names as part of the key. 'flat' ignores file structure and merges all keys."
        },
        "i18nBoost.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable extension features."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node16 --external:vscode --external:jsonc-parser --minify --outfile=dist/extension.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha -r ts-node/register test/**/*.test.ts",
    "test:coverage": "nyc npm test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "package": "vsce package",
    "publish:patch": "npm version patch && git push --follow-tags",
    "publish:minor": "npm version minor && git push --follow-tags",
    "publish:major": "npm version major && git push --follow-tags"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.123",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.6.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "audit-ci": "^6.0.0",
    "eslint": "^8.0.0",
    "mocha": "^11.7.5",
    "nyc": "^15.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "jsonc-parser": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrgwd/i18n-boost.git"
  },
  "bugs": {
    "url": "https://github.com/mrgwd/i18n-boost/issues"
  },
  "homepage": "https://github.com/mrgwd/i18n-boost#readme"
}
